{
	"name": "itson",
	"version": "0.7.4",
	"description": "A CLI tool for configuration-driven management of long-running interactive applications.",
	"keywords": [
		"cli",
		"process",
		"manager",
		"updater"
	],
	"homepage": "https://github.com/kitschpatrol/itson",
	"bugs": "https://github.com/kitschpatrol/itson/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/itson.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"bin": {
		"itson": "dist/cli.js"
	},
	"files": [
		"dist/*",
		"schema.json"
	],
	"scripts": {
		"build": "tsdown && node scripts/build-assets.ts",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run",
		"test:install": "pnpm link",
		"test:uninstall": "pnpm remove -g itson"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1136.0",
		"@clack/prompts": "^1.8.1",
		"@github/keytar": "^7.10.6",
		"@octokit/rest": "^22.0.1",
		"c12": "^3.3.4",
		"cron-parser": "^5.10.1",
		"cronstrue": "^3.27.0",
		"execa": "^10.0.1",
		"find-versions": "^6.0.0",
		"is-online": "^12.0.2",
		"lognow": "^0.8.2",
		"minimatch": "^10.2.6",
		"plist": "^5.0.0",
		"plur": "^6.0.0",
		"semver": "^7.8.5",
		"yargs": "^18.1.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.9.0",
		"@types/node": "~24.13.4",
		"@types/semver": "^7.8.0",
		"@types/yargs": "^17.0.35",
		"bumpp": "^12.3.0",
		"mdat-plugin-cli-help": "^3.2.0",
		"publint": "^0.3.24",
		"shx": "^0.4.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.1"
	},
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=24.16.0"
	}
}
